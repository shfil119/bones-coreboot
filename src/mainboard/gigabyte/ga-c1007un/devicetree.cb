chip northbridge/intel/sandybridge
	register "spd_addresses" = "{0x50, 0, 0x52, 0}"
	device domain 0x0 on
		device ref host_bridge on
			subsystemid 0x1458 0x5000
		end
		device ref peg10 off
		end
		device ref igd on
			subsystemid 0x1458 0xd000
		end
		chip southbridge/intel/bd82x6x # Intel 7 Series Panther Point PCH
			register "docking_supported" = "0"
			register "gen1_dec" = "0x003c0a01"
			register "gen2_dec" = "0x00000000"
			register "gen3_dec" = "0x00000000"
			register "gen4_dec" = "0x00000000"
			register "pcie_hotplug_map" = "{ 0, 0, 0, 0, 0, 0, 0, 0 }"
			register "pcie_port_coalesce" = "1"
			register "sata_interface_speed_support" = "0x3"
			register "sata_port_map" = "0x35"
			register "spi_lvscc" = "0x2005"
			register "spi_uvscc" = "0x2005"
			register "usb_port_config" = "{
				{1, 0, 0},
				{1, 0, 0},
				{1, 0, 1},
				{1, 0, 1},
				{1, 0, 2},
				{1, 0, 2},
				{1, 0, 3},
				{1, 0, 3},
				{1, 0, 4},
				{1, 0, 4},
				{1, 0, 6},
				{1, 0, 5},
				{1, 0, 5},
				{1, 0, 6},
			}"
			device ref mei1 on
				subsystemid 0x1458 0x1c3a
			end
			device ref mei2 off
			end
			device ref me_ide_r off
			end
			device ref me_kt off
			end
			device ref gbe off
			end
			device ref ehci2 on
				subsystemid 0x1458 0x5006
			end
			device ref hda on
				subsystemid 0x1458 0xa002
			end
			device ref pcie_rp1 on
				subsystemid 0x1458 0x5001
			end
			device ref pcie_rp2 on
				subsystemid 0x1458 0x5001
			end
			device ref pcie_rp3 on
				subsystemid 0x1458 0x5001
				device pci 00.0 on
					subsystemid 0x1458 0x8892
				end
			end
			device ref pcie_rp4 on
				subsystemid 0x1458 0x5001
			end
			device ref pcie_rp5 off
			end
			device ref pcie_rp6 off
			end
			device ref pcie_rp7 off
			end
			device ref pcie_rp8 off
			end
			device ref ehci1 on
				subsystemid 0x1458 0x5006
			end
			device ref pci_bridge off
			end
			device ref lpc on
				subsystemid 0x1458 0x5001
				chip superio/ite/it8728f

					register "TMPIN1.mode"   = "THERMAL_RESISTOR"
					register "TMPIN1.min"    = "-10"
					register "TMPIN1.max"    = "100"
					register "TMPIN2.mode"   = "THERMAL_MODE_DISABLED"
					register "TMPIN3.mode"   = "THERMAL_PECI"
					register "TMPIN3.offset" = "100"
					register "TMPIN3.min"    = "0"
					register "TMPIN3.max"    = "100"

					register "ec.vin_mask"   = "VIN7 | VIN4 | VIN3 | VIN2 | VIN1 | VIN0"

					device pnp 2e.0 off end	# Floppy
					device pnp 2e.1 on	# Serial Port 1
						io 0x60 = 0x3f8
						irq 0x70 = 4
					end
					device pnp 2e.2 on	# Serial Port 2
						io 0x60 = 0x2f8
						irq 0x70 = 3
					end
					device pnp 2e.3 on # Parallel Port
						io 0x60 = 0x378
						irq 0x70 = 5
						io 0x62 = 0x000
						drq 0x74 = 4
					end
					device pnp 2e.4 on	# EC
						io 0x60 = 0xa30
						irq 0x70 = 9
						io 0x62 = 0x230
					end
					device pnp 2e.5 on	# Keyboard
						io 0x60 = 0x60
						irq 0x70 = 1
						io 0x62 = 0x64
						irq 0x71 = 2
					end
					device pnp 2e.6 on	# Mouse
						irq 0x70 = 0xc02
					end
					device pnp 2e.7 on # GPIO
						irq 0x25 = 40
						irq 0x26 = 0f
						irq 0x27 = 10
						irq 0x2c = 80
						io 0x60  = 0x0000
						io 0x62  = 0x0a00
						io 0x64  = 0x0000
						irq 0x70 = 00
						irq 0x72 = 20
						irq 0xb8 = 20
						irq 0xc0 = 01
						irq 0xc1 = 0c
						irq 0xc3 = 40
						irq 0xc8 = 01
						irq 0xe9 = 21
						irq 0xf0 = 10
						irq 0xf1 = 42
						irq 0xf0 = 1c
					end
					device pnp 2e.a off end	# IR
				end
			end
			device ref sata1 on
				subsystemid 0x1458 0xb005
			end
			device ref smbus on
				subsystemid 0x1458 0x5001
			end
			device ref sata2 off
			end
			device ref thermal off
			end
		end
	end
end
